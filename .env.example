# Chaves da nuvem (Supabase). Copie este arquivo para ".env" e preencha,
# OU cadastre estas mesmas variáveis no painel do Vercel (recomendado).
#
# Onde achar: Supabase → Project Settings (⚙️) → API
#   REACT_APP_SUPABASE_URL       = "Project URL"
#   REACT_APP_SUPABASE_ANON_KEY  = chave "anon public"
#
# Pode compartilhar a chave anon sem risco — ela é pública por design.

REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
